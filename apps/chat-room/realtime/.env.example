# ---- Service ----
PORT=3002
NODE_ENV=development
LOG_LEVEL=debug
WEBSOCKET_MAX_CONNECTIONS=10000

# ---- Supabase Authentication ----
# Base URL of the Supabase project. Used to discover JWKS (asymmetric projects,
# e.g. ES256/RS256) at {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://your-project.supabase.co
# Required only for legacy Supabase projects that still sign JWTs with a
# shared HS256 secret. If the project has migrated to asymmetric signing keys,
# this can be omitted; the service will use the JWKS endpoint instead.
SUPABASE_JWT_SECRET=
# Optional explicit audience/issuer overrides. If unset, issuer defaults to
# `${SUPABASE_URL}/auth/v1` and audience defaults to `authenticated`.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# ---- PostgreSQL (durable store, existing Supabase Postgres) ----
DATABASE_URL=postgresql://user:password@host:5432/database

# ---- Redis (hot history, pub/sub, streams, locks, rate limiting) ----
REDIS_URL=redis://localhost:6379

# ---- Core API adapter ----
# The Chat service never owns users/rooms/membership/permissions. It resolves
# them from the existing Core API through this adapter.
CORE_API_BASE_URL=http://localhost:3001
CORE_API_AUTH_ENDPOINT=/api/rooms/:roomId/authorize
CORE_API_PROFILE_ENDPOINT=/api/users/:userId/profile
CORE_API_TIMEOUT_MS=3000

# ---- Chat configuration ----
CHAT_MAX_MESSAGE_LENGTH=500
CHAT_RATE_LIMIT_MESSAGES=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=1
CHAT_CONNECTION_RATE_LIMIT=20
CHAT_CONNECTION_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_HISTORY_RATE_LIMIT=30
CHAT_HISTORY_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_HISTORY_LIMIT=100
CHAT_HISTORY_MAX_LIMIT=500
CHAT_REDIS_RETENTION_MINUTES=60
CHAT_BUCKET_SIZE_MINUTES=5
CHAT_PERSISTENCE_BATCH_SIZE=200
CHAT_PERSISTENCE_INTERVAL_MS=2000
CHAT_PERSISTENCE_STREAM_MAXLEN=200000
CHAT_AUTH_CACHE_TTL_SECONDS=30
CHAT_HISTORY_LOCK_TTL_SECONDS=5
